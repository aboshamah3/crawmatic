{
  "case_id": "amazon_adversarial_currency_identity_conflict",
  "domain": "amazon",
  "category": "adversarial",
  "synthetic": true,
  "provenance": {
    "note": "synthetic; CSS and JSON-LD report the numerically-same price but disagree on currency (a leftover cached block from a different storefront) — CandidateIdentity.conflicts_with must treat that as a real identity conflict, a tie of two size-1 groups, hence Conflict rather than an arbitrary pick"
  },
  "input": {
    "kind": "html_inline",
    "html": "<html><head><title>Cross-listed SKU</title><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Product\", \"name\": \"Cross-listed SKU\", \"offers\": {\"@type\": \"Offer\", \"price\": \"129.00\", \"priceCurrency\": \"USD\", \"availability\": \"https://schema.org/InStock\"}}</script></head><body>\n<span id=\"productTitle\">Cross-listed SKU</span>\n<div id=\"corePrice_feature_div\">\n<span class=\"a-price-symbol\">SAR</span><span class=\"a-price-whole\">129.00</span>\n\n</div>\n<div id=\"availability\"><span>In Stock.</span></div>\n\n</body></html>",
    "profile": {
      "price_selector": ".a-price-whole",
      "currency_selector": ".a-price-symbol",
      "stock_selector": "#availability span",
      "title_selector": "#productTitle",
      "old_price_selector": ".old-price .a-offscreen"
    }
  },
  "expected": {
    "identity": {
      "primary_id": null,
      "title_contains": null
    },
    "current_price": null,
    "old_price": null,
    "currency": null,
    "stock": null,
    "seller": null,
    "shipping": null,
    "coupon": null,
    "landed_total": null,
    "expect_conflict": true,
    "expect_no_price": false
  }
}
