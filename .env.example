# Environment configuration for the Crawmatic monorepo skeleton.
#
# Copy this file to `.env` (git-ignored) before running
# `docker compose up --build -d`. The placeholders below are safe for
# local development only — no real secrets are committed here.
#
# Every variable is drawn from specs/001-monorepo-skeleton/contracts/environment.md
# (the authoritative catalogue). `app_shared/config.py` (pydantic-settings)
# fails fast if a required variable is missing (FR-017).
#
# ============================================================================
# LOCAL-DEV DEFAULTS vs. PRODUCTION-REQUIRED — READ BEFORE DEPLOYING
# ============================================================================
# Production-readiness audit (CORE_PRODUCT_PRODUCTION_READINESS_AUDIT_
# 2026-08-15.md §L1): every value below works unedited for a clean local
# `docker compose up`, and that is deliberate — but several of them are
# LOCAL-ONLY placeholders that must NEVER reach a production deployment
# verbatim. Every line below carrying a "# PRODUCTION:" comment marks one
# of those; each is individually flagged. As a checklist, production
# MUST override:
#
#   - JWT_SECRET               — real random secret, not the placeholder
#   - ENCRYPTION_KEYS           — real generated Fernet key(s)
#   - SCRAPYD_PASSWORD          — real credential, not "change-me"
#   - SAAS_SERVICE_TOKEN        — real generated token, or leave unset
#   - DATABASE_URL              — a distinct, least-privileged application
#                                 role, NEVER the `crawmatic` bootstrap/owner
#                                 role below (table owners bypass RLS)
#   - POSTGRES_PASSWORD         — real credential, not "crawmatic"
#   - PGBOUNCER_AUTH_TYPE        — "scram_sha_256" (or similar) with a real
#                                 userlist, never "trust"
#
# `app_shared.config_validation.assert_production_safe()` enforces this
# checklist automatically and refuses to start (raises
# `ProductionConfigError`) when `ENVIRONMENT=production` (or Railway's
# auto-injected `RAILWAY_ENVIRONMENT_NAME=production`) is set and any of
# the above is still the placeholder/example value — see that module's
# docstring, including the extension point reserved for the live
# BYPASSRLS/role-ownership database probe (a separate workstream).
# ============================================================================

# --- Database (api, scheduler, worker; scrapers later) ---
# Host must be pgbouncer:6432 — app services never talk to postgres:5432
# directly (FR-011).
# PRODUCTION: this `crawmatic` role is the PostgreSQL bootstrap/owner
# identity (POSTGRES_USER below) — it BYPASSES RLS by definition (table
# owners always do). Production MUST point DATABASE_URL at a distinct,
# least-privileged, non-owner application role instead (audit §C3/§L1).
DATABASE_URL=postgresql+psycopg://crawmatic:crawmatic@pgbouncer:6432/crawmatic
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- Migration job only (direct-to-Postgres, bypasses PgBouncer) ---
# App services (api/scheduler/worker) use DATABASE_URL above (pooler,
# pgbouncer:6432) and never set this. Only the one-shot migration job /
# Alembic env.py uses MIGRATION_DATABASE_URL, connecting directly to
# postgres:5432 — advisory locks and concurrent index builds are unsafe
# through the transaction pooler.
MIGRATION_DATABASE_URL=postgresql+psycopg://crawmatic:crawmatic@postgres:5432/crawmatic

# --- Redis (worker; others as needed) ---
REDIS_URL=redis://redis:6379/0

# --- Scrapyd pools & auth (worker; scrapers nodes) ---
# Comma-separated pools (FR-018); a single URL is still treated as a pool.
SCRAPYD_HTTP_URLS=http://scrapers:6800
SCRAPYD_BROWSER_URLS=http://scrapers-browser:6800
SCRAPYD_USERNAME=scrapyd
# PRODUCTION: generate a real credential — never ship "change-me".
SCRAPYD_PASSWORD=change-me

# --- API surface ---
# API_PORT is the single canonical API-port variable: it is both the
# host-published port and (via compose `environment: PORT=${API_PORT}`)
# the container's uvicorn --port, so listen/publish/healthcheck ports
# never diverge (FR-017).
API_PORT=8000
API_PUBLIC_BASE_URL=https://api.example.com
INTERNAL_API_BASE_URL=http://api:8000

# --- Auth / JWT (api; required — fails fast if unset, SPEC-03 FR-024) ---
# Local-only placeholder — generate a real random secret per environment
# (e.g. `openssl rand -hex 32`) and never commit a real value.
# PRODUCTION: must not equal this placeholder and must be >= 32 bytes.
JWT_SECRET=change-me-local-dev-secret-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- SaaS control-plane service auth (api; PLAN §7.1) ---
# Static bearer token used by the SaaS control plane for /v1/admin/* .
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset to disable the admin surface entirely.
# PRODUCTION: if you host a SaaS control plane, set this to a real
# generated token (>= 32 bytes) — never leave it blank-but-present.
SAAS_SERVICE_TOKEN=

# --- Status cache TTL (api; SPEC-03 FR-022) ---
STATUS_CACHE_TTL_SECONDS=30

# --- Login rate limiting (api; SPEC-03 FR-007) ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- API-key last_used throttle (api; SPEC-03 FR-015) ---
API_KEY_LAST_USED_THROTTLE_SECONDS=60

# --- Auth DB role (api; optional but required to actually authenticate) ---
# A dedicated `crawmatic_auth` role with BYPASSRLS, used ONLY for
# pre-context credential lookups (user-by-email, api-key-by-prefix).
# Without it, get_auth_session() fails fast (SPEC-03 [analyze C1]) rather
# than silently returning 0 rows under FORCE RLS.
AUTH_DATABASE_URL=postgresql+psycopg://crawmatic_auth:crawmatic@pgbouncer:6432/crawmatic

# --- Argon2id tuning (api; optional — argon2-cffi recommended defaults
# apply when unset) ---
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4

# --- Secret encryption (api, worker, scrapers; required — fails fast if
# unset, SPEC-10 FR-003, §33). Comma-separated "version:key" pairs; each
# key is a urlsafe-base64 Fernet key (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# Local-only placeholder below — generate a real key per environment and
# never commit a real value. ---
# PRODUCTION: must not contain this placeholder key.
ENCRYPTION_KEYS=1:DDdqY9HwOBbYpfuS_6K-Z_fa75VD5fxAt0HNkdYP940=
ENCRYPTION_PRIMARY_KEY_VERSION=1

# --- Access-policy resolution cache (api, worker; SPEC-10 FR-010/FR-011) ---
ACCESS_RESOLUTION_CACHE_TTL_SECONDS=30

# --- Public API per-key rate limits (requests per minute, per credential). ---
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_READ_PER_MINUTE=60
API_RATE_LIMIT_WRITE_PER_MINUTE=10

# --- Local infra bootstrap (compose only) ---
# PRODUCTION: this whole block is local-dev-only. POSTGRES_USER is the
# PostgreSQL bootstrap/owner role (BYPASSRLS by definition) — production
# must provision it once, then have every app service connect through a
# separate least-privileged role (see DATABASE_URL/AUTH_DATABASE_URL
# above), never this one directly.
POSTGRES_USER=crawmatic
# PRODUCTION: generate a real credential — never ship "crawmatic".
POSTGRES_PASSWORD=crawmatic
POSTGRES_DB=crawmatic
# PRODUCTION: must be "scram_sha_256" (or similar) with a real userlist —
# "trust" accepts ANY password, including none, for any listed user.
# Local only — deployed envs MUST use scram-sha-256 with a real userlist.
PGBOUNCER_AUTH_TYPE=trust
PGBOUNCER_POOL_MODE=transaction
# Dual-stack (IPv4+IPv6) bind for PgBouncer.
PGBOUNCER_LISTEN_ADDR=*

# --- Environment mode (all services; optional, unset = "not production") ---
# Read directly by `app_shared.config_validation.is_production()` (not
# through Settings — see that module's docstring). Railway's
# auto-injected RAILWAY_ENVIRONMENT_NAME is honored too, so most Railway
# deployments never need to set this explicitly.
# ENVIRONMENT=production
